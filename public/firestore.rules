rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read and write their own profile data and subcollections.
    match /users/{userId}/{document=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Rules for the 'orders' collection.
    match /orders/{orderId} {
      // CREATE: A user can create an order for themselves.
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;

      // READ: A user can read their own orders.
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;

      // UPDATE & DELETE: Disallow for data integrity.
      allow delete: if false;
    }
  }
}