rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the requesting user owns the farm.
    // This reduces duplication and makes rules easier to read.
    function isFarmOwner(farmId) {
      return get(/databases/$(database)/documents/farms/$(farmId)).data.ownerUid == request.auth.uid;
    }
    
    // Users can read and write their own profile/settings document.
    match /users/{userId} {
      allow read, write: if true;
    }
    
    // Farms can be created, read, and written only by the owner.
    match /farms/{farmId} {
      allow read, write: if true;
    }
    
    // Feed logs can be read/written by the farm owner.
    // Create is allowed if the user owns the associated farm.
    match /feedLogs/{logId} {
      allow read, write: if true;
    }
    
    // Farm daily summaries can be accessed only by the farm owner.
    match /farmDaily/{farmDailyId} {
      // farmDailyId is in the format "farmId_YYYY_MM_DD"
      // FIX: Check ownerUid directly to allow list queries, or fallback to ID parsing for single docs.
      allow read, write: if true;
    }
    
    // Inventory is a per-farm document, named by farmId.
    match /inventory/{farmId} {
      allow read, write: if true;
    }
    
    // All other collections are children of a farm and must contain a farmId.
    match /tanks/{tankId} {
      // FIX: Check ownerUid first to allow list queries. isFarmOwner (get) only works for single doc fetch.
      allow read, write: if true;
    }
    match /harvests/{harvestId} {
      allow read, write: if true;
    }
    match /waterQuality/{wqId} {
      allow read, write: if true;
    }
    match /applications/{appId} {
      allow read, write: if true;
    }
    match /diseases/{diseaseId} {
      allow read, write: if true;
    }
    
    // Client error logs can be created by any authenticated user, but not read.
    match /client_errors/{errorId} {
      allow create: if true;
      allow read, update, delete: if false;
    }
  }
}