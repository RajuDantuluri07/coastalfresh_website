rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the signed-in user is the admin.
    function isAdmin() {
      // List of admin UIDs, should be kept in sync with admin.js
      return request.auth.uid in ["p4uS2H3JFXNvmhkQWftUH721a2n2", "pel0OXjpAva5fe9367PgIHsRaak1"];
    }

    // A user can read/write their own document and subcollections (e.g., addresses)
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Admins can read all user documents for stats and role management
    match /users/{userId} {
      allow read, update: if isAdmin();
    }

    // Rules for the 'orders' collection
    match /orders/{orderId} {
      // Any authenticated user can create an order for themselves.
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;

      // A user can read their own order, OR an admin can read any order.
      allow read: if request.auth != null && (request.auth.uid == resource.data.userId || isAdmin());

      // Only an admin can update an order (e.g., to change the status).
      allow update: if isAdmin();

      // No one can delete orders from the app for record-keeping.
      allow delete: if false;
    }
    
    // Rules for the 'summaries' collection
    match /summaries/{summaryId} {
      // Only admins can read and write to the daily summaries
      allow read, write: if isAdmin();
    }
  }
}