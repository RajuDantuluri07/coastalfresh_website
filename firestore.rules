rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---

    // Check if user is logged in
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if user is accessing their own document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Check if user has 'admin' role (for Dashboard access)
    function isAdmin() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // --- RBAC HELPERS (Ticket 2 & 3) ---

    // Get the Farm document
    function getFarmData(farmId) {
      return get(/databases/$(database)/documents/farms/$(farmId)).data;
    }

    // Check if user is the Farm Owner (Ticket 1: Final Authority)
    function isFarmOwner(farmId) {
      return isAuthenticated() && getFarmData(farmId).ownerId == request.auth.uid;
    }

    // Get User Role from 'members' subcollection
    // Path: farms/{farmId}/members/{uid}
    function getMemberRole(farmId) {
      let path = /databases/$(database)/documents/farms/$(farmId)/members/$(request.auth.uid);
      return exists(path) ? get(path).data.role : null;
    }

    // Role: Worker (Data Executor)
    // Can create operational data.
    function isWorker(farmId) {
      return isFarmOwner(farmId) || getMemberRole(farmId) == 'worker';
    }

    // Role: Dealer (Financial Counterparty)
    // Can see credit ledger only.
    function isDealer(farmId) {
      return isFarmOwner(farmId) || getMemberRole(farmId) == 'dealer';
    }

    // Role: Lab (Data Provider)
    // Can upload water test reports.
    function isLab(farmId) {
      return isFarmOwner(farmId) || getMemberRole(farmId) == 'lab';
    }

    // Role: Technician (Advisory Only)
    // Can view ponds, add advisory notes.
    function isTechnician(farmId) {
      return isFarmOwner(farmId) || getMemberRole(farmId) == 'technician';
    }

    // View Ponds Permission (Farmer, Worker, Lab, Technician)
    function canViewPonds(farmId) {
      let role = getMemberRole(farmId);
      return isFarmOwner(farmId) || role in ['worker', 'lab', 'technician'];
    }

    // --- COLLECTION RULES ---

    // 1. Users Collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    // 2. Farms Collection
    match /farms/{farmId} {
      allow create: if isAuthenticated();
      
      // Read: Owner or any Member
      allow read: if isFarmOwner(farmId) || getMemberRole(farmId) != null;
      
      // Update/Delete: Owner Only (Ticket 1)
      allow update, delete: if isFarmOwner(farmId);

      // Members Subcollection (RBAC Source of Truth)
      // Ticket 6: Only farm owner can add/remove members
      match /members/{memberId} {
        allow read: if isFarmOwner(farmId) || request.auth.uid == memberId;
        allow write: if isFarmOwner(farmId);
      }
    }

    // 3. Tanks Collection
    match /tanks/{tankId} {
      // View: Farmer, Worker, Lab, Technician (Ticket 2)
      allow read: if isAuthenticated() && canViewPonds(resource.data.farmId);
      // Create/Update: Farmer Only (Worker cannot modify structure)
      allow create, update: if isAuthenticated() && isFarmOwner(request.resource.data.farmId);
      // Delete: Farmer Only
      allow delete: if isAuthenticated() && isFarmOwner(resource.data.farmId);
    }

    // 4. Feed Entries Collection
    match /feedEntries/{entryId} {
      // Read: Farmer, Worker, Technician (Tray results)
      allow read: if isAuthenticated() && (isWorker(resource.data.farmId) || isTechnician(resource.data.farmId));
      // Create: Farmer, Worker (Ticket 2)
      allow create: if isAuthenticated() && isWorker(request.resource.data.farmId);
      // Update: BLOCKED (Ticket 4: Immutable)
      allow update: if false;
      // Delete: Farmer Only (Ticket 1)
      allow delete: if isAuthenticated() && isFarmOwner(resource.data.farmId);
    }

    // 5. Invitations Collection
    match /invitations/{inviteId} {
      // Create: Farmer Only (Ticket 6)
      allow create: if isAuthenticated() && isFarmOwner(request.resource.data.farmId);
      allow read: if isAuthenticated() && (
        resource.data.invitedByUid == request.auth.uid ||
        resource.data.invitedPhone == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.phone
      );
      allow update: if isAuthenticated(); 
    }

    // 6. Market Prices (for Dashboard)
    match /marketPrices/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 7. Inventory (Doc ID is Farm ID)
    match /inventory/{farmId} {
      // Read: Farmer, Worker (Operational need)
      allow read: if isAuthenticated() && isWorker(farmId);
      // Write: Farmer Only (Ticket 3: Inventory cannot be modified by non-farmer roles)
      allow write: if isAuthenticated() && isFarmOwner(farmId);
    }

    // 8. Water Analysis
    match /waterEntries/{entryId} {
      // Read: Farmer, Lab, Technician (Ticket 2)
      allow read: if isAuthenticated() && (isLab(resource.data.farmId) || isTechnician(resource.data.farmId));
      // Create: Farmer, Lab
      allow create: if isAuthenticated() && isLab(request.resource.data.farmId);
      // Update: BLOCKED (Ticket 4: Immutable)
      allow update: if false;
      // Delete: Farmer Only
      allow delete: if isAuthenticated() && isFarmOwner(resource.data.farmId);
    }

    // 9. Harvests
    match /harvests/{entryId} {
      allow read: if isAuthenticated() && isWorker(resource.data.farmId);
      allow create: if isAuthenticated() && isWorker(request.resource.data.farmId);
      allow update: if false;
      allow delete: if isAuthenticated() && isFarmOwner(resource.data.farmId);
    }

    // 10. Sampling
    match /sampling/{entryId} {
      allow read: if isAuthenticated() && isWorker(resource.data.farmId);
      allow create: if isAuthenticated() && isWorker(request.resource.data.farmId);
      allow update: if false;
      allow delete: if isAuthenticated() && isFarmOwner(resource.data.farmId);
    }

    // 11. Medicine (Inventory & Apps)
    match /medicineInventory/{itemId} {
      allow read: if isAuthenticated() && isWorker(resource.data.farmId);
      allow write: if isAuthenticated() && isFarmOwner(resource.data.farmId);
    }
    match /medicineApplications/{appId} {
      allow read: if isAuthenticated() && isWorker(resource.data.farmId);
      allow create: if isAuthenticated() && isWorker(request.resource.data.farmId);
      allow update: if false;
      allow delete: if isAuthenticated() && isFarmOwner(resource.data.farmId);
    }

    // 12. Advisory Notes (Ticket 5)
    match /advisoryNotes/{noteId} {
      // Read: Farmer, Technician
      allow read: if isAuthenticated() && isTechnician(resource.data.farmId);
      // Create: Technician (and Farmer)
      allow create: if isAuthenticated() && isTechnician(request.resource.data.farmId);
      // Update: BLOCKED
      allow update: if false;
      // Delete: Farmer Only
      allow delete: if isAuthenticated() && isFarmOwner(resource.data.farmId);
    }

    // 13. Credit Ledger (Ticket 2)
    match /creditLedger/{entryId} {
      // Read: Farmer, Dealer
      allow read: if isAuthenticated() && isDealer(resource.data.farmId);
      // Create: Farmer, Dealer
      allow create: if isAuthenticated() && isDealer(request.resource.data.farmId);
      // Update: BLOCKED
      allow update: if false;
      // Delete: Farmer Only
      allow delete: if isAuthenticated() && isFarmOwner(resource.data.farmId);
    }

    // 14. Alerts (Ticket 1)
    match /alerts/{alertId} {
      allow read: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }
  }
}