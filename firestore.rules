rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- HELPER FUNCTIONS ---
    
    // Check if the authenticated user is the owner or a member of the specific farm
    function canAccessFarm(farmId) {
      let farm = get(/databases/$(database)/documents/farms/$(farmId));
      return farm != null && (
        farm.data.ownerId == request.auth.uid || 
        (farm.data.memberIds != null && request.auth.uid in farm.data.memberIds)
      );
    }

    // --- COLLECTION RULES ---

    // Users: Users can only read/write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Farms: Owners have full access; Members can read and update (but not delete)
    match /farms/{farmId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null && (
        resource.data.ownerId == request.auth.uid || 
        (resource.data.memberIds != null && request.auth.uid in resource.data.memberIds)
      );
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    // Farm Data Collections (Tanks, Feed, Water, etc.)
    // These collections rely on the 'farmId' field inside the document to verify access.
    match /{collection}/{docId} {
      function isFarmData() {
        return collection in ['tanks', 'feedEntries', 'waterEntries', 'harvests', 'expenses', 'tasks', 'sampling', 'medicineInventory', 'medicineApplications'];
      }
      
      // Allow read/delete if user has access to the farm referenced in the existing document
      allow read, delete: if request.auth != null && isFarmData() && canAccessFarm(resource.data.farmId);
      
      // Allow create if user has access to the farm referenced in the new document
      allow create: if request.auth != null && isFarmData() && canAccessFarm(request.resource.data.farmId);
      
      // Allow update if user has access to both the existing farm and the new farm (prevents moving data to unauthorized farms)
      allow update: if request.auth != null && isFarmData() && canAccessFarm(resource.data.farmId) && canAccessFarm(request.resource.data.farmId);
    }

    // Inventory (The Document ID is the Farm ID)
    match /inventory/{farmId} {
      allow read, write: if request.auth != null && canAccessFarm(farmId);
    }

    // Invitations
    match /invitations/{inviteId} {
      allow create: if request.auth != null && request.resource.data.invitedByUid == request.auth.uid;
      // Allow reading/updating if you are the sender OR the receiver (matched by phone number)
      allow read, update: if request.auth != null && (
        resource.data.invitedByUid == request.auth.uid ||
        resource.data.invitedPhone == request.auth.token.phone_number
      );
    }
  }
}