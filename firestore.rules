rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---

    // Check if user is logged in
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if user is accessing their own document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Check if user has 'admin' role (for Dashboard access)
    function isAdmin() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Check if user is a member of the farm (Owner or in memberIds array)
    // This looks up the parent farm document to verify access for Tanks/Feeds
    function isFarmMember(farmId) {
      let farmData = get(/databases/$(database)/documents/farms/$(farmId)).data;
      return isAuthenticated() && (
        farmData.ownerId == request.auth.uid || 
        (farmData.memberIds != null && farmData.memberIds.hasAny([request.auth.uid]))
      );
    }

    // --- COLLECTION RULES ---

    // 1. Users Collection
    // Users can read/write their own profile. Admins can read all (for dashboard list).
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    // 2. Farms Collection
    match /farms/{farmId} {
      // Anyone logged in can create a farm
      allow create: if isAuthenticated();
      
      // Read/Update if you are the owner or a member
      allow read, update: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid || 
        resource.data.memberIds.hasAny([request.auth.uid])
      );
      
      // Only Owner can delete
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // 3. Tanks Collection
    // Access depends on the parent Farm's membership (via farmId field)
    match /tanks/{tankId} {
      allow read: if isAuthenticated() && isFarmMember(resource.data.farmId);
      allow create: if isAuthenticated() && isFarmMember(request.resource.data.farmId);
      allow update, delete: if isAuthenticated() && isFarmMember(resource.data.farmId);
    }

    // 4. Feed Entries Collection
    // Access depends on the parent Farm's membership
    match /feedEntries/{entryId} {
      allow read: if isAuthenticated() && isFarmMember(resource.data.farmId);
      allow create: if isAuthenticated() && isFarmMember(request.resource.data.farmId);
      allow update, delete: if isAuthenticated() && isFarmMember(resource.data.farmId);
    }

    // 5. Invitations Collection
    match /invitations/{inviteId} {
      // Create: Must be a member of the farm being invited to
      allow create: if isAuthenticated() && isFarmMember(request.resource.data.farmId);
      // Read: Sender or Receiver (checked via phone number in User profile)
      allow read: if isAuthenticated() && (
        resource.data.invitedByUid == request.auth.uid ||
        resource.data.invitedPhone == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.phone
      );
      // Update: Receiver can accept/reject
      allow update: if isAuthenticated(); 
    }

    // 6. Market Prices (for Dashboard)
    match /marketPrices/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 7. Inventory (Doc ID is Farm ID)
    match /inventory/{farmId} {
      allow read, write: if isAuthenticated() && isFarmMember(farmId);
    }

    // 8. Water Analysis
    match /waterEntries/{entryId} {
      allow read: if isAuthenticated() && isFarmMember(resource.data.farmId);
      allow create: if isAuthenticated() && isFarmMember(request.resource.data.farmId);
      allow update, delete: if isAuthenticated() && isFarmMember(resource.data.farmId);
    }

    // 9. Harvests
    match /harvests/{entryId} {
      allow read: if isAuthenticated() && isFarmMember(resource.data.farmId);
      allow create: if isAuthenticated() && isFarmMember(request.resource.data.farmId);
      allow update, delete: if isAuthenticated() && isFarmMember(resource.data.farmId);
    }

    // 10. Sampling
    match /sampling/{entryId} {
      allow read: if isAuthenticated() && isFarmMember(resource.data.farmId);
      allow create: if isAuthenticated() && isFarmMember(request.resource.data.farmId);
      allow update, delete: if isAuthenticated() && isFarmMember(resource.data.farmId);
    }

    // 11. Medicine (Inventory & Apps)
    match /medicineInventory/{itemId} {
      allow read: if isAuthenticated() && isFarmMember(resource.data.farmId);
      allow create: if isAuthenticated() && isFarmMember(request.resource.data.farmId);
      allow update, delete: if isAuthenticated() && isFarmMember(resource.data.farmId);
    }
    match /medicineApplications/{appId} {
      allow read: if isAuthenticated() && isFarmMember(resource.data.farmId);
      allow create: if isAuthenticated() && isFarmMember(request.resource.data.farmId);
      allow update, delete: if isAuthenticated() && isFarmMember(resource.data.farmId);
    }
  }
}